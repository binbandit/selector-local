{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "types": ["chrome", "node", "bun"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/extension/**/*.ts", "tests/**/*.ts"]
}
