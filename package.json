{
  "name": "selector-local",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js && bun scripts/build-extension.ts && bun run package",
    "check": "tsc --noEmit",
    "test": "bun run build && bun test",
    "dev": "bun scripts/serve.ts",
    "package": "cd dist/extension && zip -qr ../selector-local.zip ."
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dom-accessibility-api": "^0.7.1"
  }
}
