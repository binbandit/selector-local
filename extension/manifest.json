{
  "manifest_version": 3,
  "name": "Selector Local",
  "version": "1.0.2",
  "description": "Pick page elements, annotate changes, copy verified context, and save complete screenshots. A personal extension based on Selector.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "downloads", "contextMenus", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Toggle Selector Local", "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": { "toggle-selector": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Toggle Selector Local across tabs" } },
  "options_page": "options.html",
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["bridge.js"], "run_at": "document_idle" }]
}
